+package com.android.ims;
+
+import android.app.Service;
+import android.content.Intent;
+import android.os.Binder;
+import android.os.IBinder;
+
+/**
+ * Compatibility stub for vendor IMS implementations that extend ImsServiceBase.
+ */
+public abstract class ImsServiceBase extends Service {
+
+    public static class ImsServiceBinder extends Binder {
+    }
+
+    protected ImsServiceBinder mBinder;
+
+    public ImsServiceBinder getBinder() {
+        if (mBinder == null) {
+            mBinder = new ImsServiceBinder();
+        }
+        return mBinder;
+    }
+
+    @Override
+    public IBinder onBind(Intent intent) {
+        return getBinder();
+    }
+}
