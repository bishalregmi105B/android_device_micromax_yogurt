+    // Extra hardware button (e.g. Micromax IN Note 1 dedicated assistant button)
+    private boolean mExtraButtonLongPressed = false;
+    private final Runnable mExtraButtonLongPressRunnable = new Runnable() {
+        @Override
+        public void run() {
+            mExtraButtonLongPressed = true;
+            performHapticFeedback(HapticFeedbackConstants.LONG_PRESS, "Extra Button - Long Press");
+            showExtraButtonAppPicker();
+        }
+    };
+
+    private void handleExtraButtonEvent(KeyEvent event, int policyFlags) {
+        final boolean down = event.getAction() == KeyEvent.ACTION_DOWN;
+        final boolean interactive = (policyFlags & WindowManagerPolicy.FLAG_INTERACTIVE) != 0;
+
+        if (!interactive) {
+            if (down) {
+                wakeUpFromWakeKey(event);
+            }
+            return;
+        }
+
+        if (down) {
+            if (event.getRepeatCount() == 0) {
+                mExtraButtonLongPressed = false;
+                mHandler.postDelayed(mExtraButtonLongPressRunnable, 500);
+            }
+        } else {
+            mHandler.removeCallbacks(mExtraButtonLongPressRunnable);
+            if (mExtraButtonLongPressed) {
+                mExtraButtonLongPressed = false;
+            } else {
+                performHapticFeedback(HapticFeedbackConstants.VIRTUAL_KEY, "Extra Button - Press");
+                handleExtraButtonPress(false);
+            }
+        }
+    }
+
+    private void handleExtraButtonPress(boolean forcePicker) {
+        final ContentResolver resolver = mContext.getContentResolver();
+        final PackageManager pm = mContext.getPackageManager();
+        final String selectedPkg = Settings.System.getString(resolver, "extra_button_app");
+
+        if (!forcePicker && selectedPkg != null && !selectedPkg.isEmpty()) {
+            Intent launchIntent = pm.getLaunchIntentForPackage(selectedPkg);
+            if (launchIntent != null) {
+                launchIntent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK
+                        | Intent.FLAG_ACTIVITY_RESET_TASK_IF_NEEDED);
+                if (mKeyguardDelegate != null && mKeyguardDelegate.isShowing()) {
+                    mKeyguardDelegate.dismissKeyguardToLaunch(launchIntent);
+                } else {
+                    startActivityAsUser(launchIntent, UserHandle.CURRENT_OR_SELF);
+                }
+                return;
+            }
+            Settings.System.putString(resolver, "extra_button_app", null);
+        }
+
+        showExtraButtonAppPicker();
+    }
+
+    private void showExtraButtonAppPicker() {
+        mHandler.post(new Runnable() {
+            @Override
+            public void run() {
+                final PackageManager pm = mContext.getPackageManager();
+                final Intent mainIntent = new Intent(Intent.ACTION_MAIN, null);
+                mainIntent.addCategory(Intent.CATEGORY_LAUNCHER);
+
+                final List<ResolveInfo> apps = pm.queryIntentActivities(mainIntent, 0);
+                if (apps == null || apps.isEmpty()) {
+                    Slog.e(TAG, "No launchable apps found for extra button picker!");
+                    return;
+                }
+
+                apps.sort(new ResolveInfo.DisplayNameComparator(pm));
+
+                final int count = apps.size();
+                final String[] appNames = new String[count];
+                final String[] pkgNames = new String[count];
+                for (int i = 0; i < count; i++) {
+                    ResolveInfo ri = apps.get(i);
+                    CharSequence label = ri.loadLabel(pm);
+                    appNames[i] = (label != null) ? label.toString() : ri.activityInfo.packageName;
+                    pkgNames[i] = ri.activityInfo.packageName;
+                }
+
+                AlertDialog.Builder builder = new AlertDialog.Builder(mContext);
+                builder.setTitle("Select app for Extra Button");
+                builder.setItems(appNames, new DialogInterface.OnClickListener() {
+                    @Override
+                    public void onClick(DialogInterface dialog, int which) {
+                        String chosenPkg = pkgNames[which];
+                        Settings.System.putString(mContext.getContentResolver(), "extra_button_app", chosenPkg);
+                        Intent launchIntent = pm.getLaunchIntentForPackage(chosenPkg);
+                        if (launchIntent != null) {
+                            launchIntent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK
+                                    | Intent.FLAG_ACTIVITY_RESET_TASK_IF_NEEDED);
+                            if (mKeyguardDelegate != null && mKeyguardDelegate.isShowing()) {
+                                mKeyguardDelegate.dismissKeyguardToLaunch(launchIntent);
+                            } else {
+                                startActivityAsUser(launchIntent, UserHandle.CURRENT_OR_SELF);
+                            }
+                        }
+                    }
+                });
+                builder.setNegativeButton(android.R.string.cancel, null);
+
+                AlertDialog dialog = builder.create();
+                dialog.getWindow().setType(WindowManager.LayoutParams.TYPE_KEYGUARD_DIALOG);
+                dialog.show();
+            }
+        });
+    }
