diff --git a/aosp/update_attempter_android.cc b/aosp/update_attempter_android.cc
index 091d664..c7ed8bf 100644
--- a/aosp/update_attempter_android.cc
+++ b/aosp/update_attempter_android.cc
@@ -1257,6 +1257,13 @@ BootControlInterface::Slot UpdateAttempterAndroid::GetCurrentSlot() const {
 }
 
 BootControlInterface::Slot UpdateAttempterAndroid::GetTargetSlot() const {
+  // Single-slot (non-A/B) devices have no alternate slot to update into; a
+  // full OTA is applied in place (recovery deletes the source dynamic
+  // partitions from super first, then recreates them from the payload).
+  // Multi-slot devices keep the stock behavior.
+  if (boot_control_->GetNumSlots() <= 1) {
+    return GetCurrentSlot();
+  }
   return GetCurrentSlot() == 0 ? 1 : 0;
 }
 
