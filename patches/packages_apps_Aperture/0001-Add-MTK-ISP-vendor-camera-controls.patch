+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.aperture.models
+
+/**
+ * MTK MFB (multi-frame burst / MFnR) pipeline modes — values verified live on
+ * yogurt HAL: availablemfbmodes = [0, 1, 2, 255].
+ */
+enum class MtkMfbMode(val id: Int) {
+    OFF(0),
+    ON(1),
+    QUALITY(2),
+    AUTO(255),
+    ;
+
+    companion object {
+        fun from(id: Int?) = entries.firstOrNull { it.id == id }
+    }
+}
+
+/**
+ * One-dial "Turbo pipeline" level, mapped at write time into mfbmode +
+ * hdrMode + aismode (plan §4). AUTO = never write vendor keys (upstream parity).
+ */
+enum class MtkTurboLevel(val mfbId: Int) {
+    OFF(-1),
+    AUTO(255),
+    QUALITY(2),
+    ;
+}
