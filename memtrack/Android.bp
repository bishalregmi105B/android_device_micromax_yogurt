cc_binary {
    name: "android.hardware.memtrack-service.yogurt",
    stem: "android.hardware.memtrack-service.example",
    relative_install_path: "hw",
    init_rc: ["android.hardware.memtrack-service.yogurt.rc"],
    vintf_fragments: ["android.hardware.memtrack-service.yogurt.xml"],
    vendor: true,
    shared_libs: [
        "libbase",
        "libbinder_ndk",
    ],
    static_libs: [
        "android.hardware.memtrack-V1-ndk",
    ],
    srcs: [
        "main.cpp",
        "Memtrack.cpp",
    ],
}
