# ago_default is the init flow for the project > 1G

on init
    write /sys/block/zram0/comp_algorithm lz4
    write /sys/block/zram0/comp_algorithm zstd

on post-fs-data && property:ro.crypto.type=block
    mkdir /data/unencrypted

on post-fs-data && property:ro.crypto.state=unencrypted
    mkdir /data/unencrypted

on post-fs-data
    write /proc/sys/vm/page-cluster 0
    swapon_all /vendor/etc/fstab.mt6768
    write /dev/memcg/memory.swappiness 100
    write /dev/memcg/apps/memory.swappiness 100
    write /dev/memcg/system/memory.swappiness 100
    write /proc/sys/vm/swappiness 100

on property:sys.boot_completed=1
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/up_rate_limit_us 500
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/down_rate_limit_us 10000
    write /sys/devices/system/cpu/cpufreq/policy6/schedutil/up_rate_limit_us 500
    write /sys/devices/system/cpu/cpufreq/policy6/schedutil/down_rate_limit_us 20000
    write /dev/cpuset/background/cpus 0-1
    write /dev/cpuset/restricted/cpus 0-3
    write /dev/cpuset/system-background/cpus 0-3
    write /dev/cpuset/foreground/cpus 0-7
    write /dev/cpuset/top-app/cpus 0-7
