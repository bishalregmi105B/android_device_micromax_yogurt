<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Enable auxiliary cameras selector. -->
    <bool name="config_enableAuxCameras">true</bool>

    <!-- List of ID of auxiliary cameras that must be ignored by the app. -->
    <string-array name="config_ignoredAuxCameraIds">
        <item>23</item>
    </string-array>

    <!-- Enable 60 FPS video recording on FHD (1080p) -->
    <string-array name="config_additionalVideoConfigurations" translatable="false">
        <item>0</item>
        <item>fhd</item>
        <item>60</item>
    </string-array>
</resources>
