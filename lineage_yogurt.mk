# Inherit from those products. Most specific first.
$(call inherit-product, $(SRC_TARGET_DIR)/product/core_64_bit.mk)
$(call inherit-product, $(SRC_TARGET_DIR)/product/full_base_telephony.mk)

# Inherit some common Lineage stuff.
$(call inherit-product, vendor/lineage/config/common_full_phone.mk)

# Inherit from E7746 device
$(call inherit-product, device/micromax/yogurt/device.mk)

PRODUCT_DEVICE := yogurt
PRODUCT_NAME := lineage_yogurt
PRODUCT_BRAND := Micromax
PRODUCT_MODEL := IN_Note1
PRODUCT_MANUFACTURER := micromax

PRODUCT_GMS_CLIENTID_BASE := android-micromax

# [build-ledger wall 14, 2026-10-28] Removed: PRODUCT_BUILD_PROP_OVERRIDES with
# PRIVATE_BUILD_DESC (stock-A10 description "full_k69v1_64-user 10 QP1A...").
# A16's post_process_props rejects the key in partition props
# ("Key \"PRIVATE_BUILD_DESC\" isn't a valid prop override",
# build_first_20261028_192203.log:1425, odm-build.prop node) and the value was
# an Android-10 fingerprint string, wrong for a DerpFest 16.2 build anyway.
# The build description is generated by sysprop.mk from BUILD_ID/branding;
# device identity stays in BUILD_FINGERPRINT below.

BUILD_FINGERPRINT := Micromax/E7746/E7746:10/QP1A.190711.020/1620836268:user/release-keys
