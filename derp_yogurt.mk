# DerpFest product wiring for Micromax IN Note 1 (yogurt / E7746, mt6768).
# Spec: DerpFest-Micromax-INNote1-MasterPrompt.md §4/§5. Based on the
# DerpFest-Devices yogurt tree; product overrides on top of device.mk.
#

# Inherit from those products. Most specific first.
$(call inherit-product, $(SRC_TARGET_DIR)/product/core_64_bit.mk)
$(call inherit-product, $(SRC_TARGET_DIR)/product/full_base_telephony.mk)

# Inherit some common DerpFest stuff.
# (DerpFest 16.2 forks the LineageOS vendor repo INTO vendor/lineage.)
$(call inherit-product, vendor/lineage/config/common_full_phone.mk)

# Inherit from E7746 device
$(call inherit-product, device/micromax/yogurt/device.mk)

PRODUCT_DEVICE := yogurt
LINEAGE_BUILD := yogurt
PRODUCT_NAME := derp_yogurt
PRODUCT_BRAND := DerpFest
PRODUCT_MODEL := IN_Note1
PRODUCT_MANUFACTURER := micromax

PRODUCT_GMS_CLIENTID_BASE := android-micromax

# Cycle 2 Enhancements: Accord removal & Google apps integration
TARGET_INCLUDE_ACCORD := false

PRODUCT_PACKAGES += \
    Chrome-Stub \
    FilesPrebuilt

# [build-ledger wall 14, 2026-10-28] Removed: PRODUCT_BUILD_PROP_OVERRIDES with
# PRIVATE_BUILD_DESC (stock-A10 description "full_k69v1_64-user 10 QP1A...").
# A16's post_process_props rejects the key in partition props
# ("Key \"PRIVATE_BUILD_DESC\" isn't a valid prop override",
# build_first_20261028_192203.log:1425, odm-build.prop node) and the value was
# an Android-10 fingerprint string, wrong for a DerpFest 16.2 build anyway.
# The build description is generated by sysprop.mk from BUILD_ID/branding;
# device identity stays in BUILD_FINGERPRINT below.

# [build-ledger wall 22, 2026-10-29] Disabled: OTA-packaging kernel-requirements
# enforcement. check_vintf (PRODUCT_OTA_ENFORCE_VINTF_KERNEL_REQUIREMENTS=true)
# rejected the package: "Kernel FCM Version is 4 and kernel version is
# 4.14.141, but the first kernel FCM version allowed for kernel version 4.14.y
# is 6" (build_first_20261029_053208.log:805). The check guards OTAs pairing a
# new framework with an unknown, older kernel already on the device — but this
# payload SHIPS its own kernel: boot.img (4.14.141 prebuilt, wall-10 proven
# pairing which stock itself boots) travels in the same zip it initializes.
# Device/manifest VINTF verification (level-5, previously verified) is
# unaffected; only the packaging-time kernel-FCM formality is relaxed.
PRODUCT_OTA_ENFORCE_VINTF_KERNEL_REQUIREMENTS := false

# [build-ledger wall 23, 2026-10-29] Device framework compatibility matrix.
# With the kernel-FCM formality gone (above), check_vintf surfaced the next
# assertion: 27 legacy HAL interfaces in the vendor manifest that no A16
# framework compatibility matrix names (mtkradioex@1.9, lbs@1.0, nvram@1.1,
# power@2.1, microtrust capi/tface, focaltech fingerprint, configstore@1.1,
# radio@1.4 legacy instances — full list + evidence comment in the XML).
# Fixed with check_vintf's own suggested remedy #4: declare them in
# DEVICE_FRAMEWORK_COMPATIBILITY_MATRIX_FILE as optional=true acknowledgments.
# Runtime behavior unchanged; packaging-time acknowledgment only.
# [wall 23b, 07:58] Path correction: the wiring initially used $(DEVICE_PATH),
# which is a BoardConfig-context variable and EMPTY in product config — soong
# bootstrap rejected "source path /configs/vintf/framework_compatibility_matrix.xml
# does not exist" (build_first_20261029_075129.log:38). Using a literal path;
# the file is device-specific by construction.
DEVICE_FRAMEWORK_COMPATIBILITY_MATRIX_FILE := device/micromax/yogurt/configs/vintf/framework_compatibility_matrix.xml

# [build-ledger wall 27, 2026-10-30] DF16-lite: flip to DF13-style non-AB zip.
# Wall-24's AB_OTA_PARTITIONS list is removed. Mechanics
# (build/make/core/Makefile:6338-6340): defining AB_OTA_PARTITIONS errors out
# unless AB_OTA_UPDATER==true; misc_info only stamps ab_update=true when
# AB_OTA_UPDATER==true (Makefile:6176-6180, mirrored at 7565), and
# ota_from_target_files.py:1453 picks the AB payload iff ab_update=true
# (generate_ab = not force_non_ab and ab_update). With no AB vars, the
# otapackage zip is emitted DF13-style: META-INF updater-script, .dat.br image
# trio, dynamic_partitions_op_list, ota-type=BLOCK (anatomy reference:
# downloads/DerpFest-13-Official-Tango-yogurt-20250213-1114.zip). That flows
# through this device's already-flashed recovery against the real 4 GiB super,
# no engine, no slot prepare. AB_OTA_UPDATER := false explicitly so
# sysprop_config.mk:141 writes ro.build.ab_update=false instead of an empty
# property.
AB_OTA_UPDATER := false

BUILD_FINGERPRINT := Micromax/E7746/E7746:10/QP1A.190711.020/1620836268:user/release-keys
